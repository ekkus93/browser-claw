# BrowserClaw 0.1.0 release build contract.
# Copy values into the release environment; do not commit API keys or secrets.
VITE_RELEASE_VERSION=0.1.0
VITE_RELEASE_CHANNEL=rc
VITE_GIT_SHA=0123456789abcdef0123456789abcdef01234567
VITE_BUILD_UTC=2026-08-01T20:00:00Z
VITE_BASE_PATH=/browser-claw/
VITE_CHROME_EXTENSION_ID=mgobfbgnjfnlpahiniaincgpkinnodka

# Production builds are fail-closed. These must remain false.
VITE_DEMO_MODE=false
VITE_ALLOW_REFERENCE_RUNTIME_FALLBACK=false
VITE_ALLOW_MOCK_PROVIDER=false

# Provider credentials are entered by the user at runtime and remain in the
# in-memory SecretVault. They are never build-time environment variables.
