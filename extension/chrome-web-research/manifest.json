{
  "manifest_version": 3,
  "name": "BrowserClaw Web Research Companion",
  "version": "0.1.0",
  "version_name": "0.1.0-rc.1",
  "description": "Reads user-approved public web pages for BrowserClaw and returns sanitized text or Markdown. It does not read cookies, fill forms, or access pages without host permission.",
  "key": "",
  "permissions": ["tabs", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "externally_connectable": {
    "matches": [
      "https://ekkus93.github.io/browser-claw/*",
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*"
    ]
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
